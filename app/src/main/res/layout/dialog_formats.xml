<?xml version="1.0" encoding="utf-8"?>
<!-- The format list, on demand. The first-run block that carries it is shown only while
     the app holds nothing at all, so this dialog is the way back to it after the first
     file has been opened. The grid is filled by MainActivity.fillFormatGrid, the same
     call the first-run block uses, so the two can never disagree. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/formats_title"
            android:textAppearance="?attr/textAppearanceTitleLarge" />

        <GridLayout
            android:id="@+id/formatGrid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:columnCount="@integer/welcome_grid_columns"
            android:focusable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="@string/formats_detail"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</ScrollView>