<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Trini Office</string>
    <!-- The long form, kept for the About dialog, which is where someone who wants the
         detail goes looking. The first run gets welcome_headline instead. -->
    <string name="main_subtitle">Abre y visualiza documentos, hojas de cálculo, presentaciones y fotos. Todo se procesa en tu teléfono, nada se sube a internet.</string>
    <!-- Shown at the top of the first-run block and again in the "Formatos que abre" dialog -->
    <string name="welcome_headline">Trini Office abre cualquier archivo.</string>
    <!-- The strongest sentence in the product, which used to be a clause in the middle of
         main_subtitle. The second half is checkable: the About dialog reads the permission
         list back out of Android rather than asserting it. -->
    <string name="welcome_promise">No se sube nada. Trini Office no tiene permiso de internet.</string>
    <!-- Spoken form of the badge grid. The tiles themselves are not important for
         accessibility, so this is the whole announcement and it is one stop rather than
         nine, the same way a file row carries the description for its own four views. -->
    <string name="welcome_formats_spoken">Abre archivos PDF, documentos de Word, hojas de Excel, presentaciones de PowerPoint, imágenes, video, audio, Markdown y texto.</string>
    <string name="open_a_file">Abrir un archivo</string>
    <string name="recent_files">Archivos recientes</string>
    <string name="folders">Carpetas</string>
    <string name="add_folder">Agregar carpeta</string>
    <string name="no_recents_hint">Los archivos que abras aparecerán aquí para tenerlos a mano.</string>
    <string name="no_folders_hint">Concede una carpeta para explorar sus archivos aquí mismo. Trini Office no necesita permiso de almacenamiento para hacerlo.</string>
    <string name="empty_folder">No hay nada que mostrar en esta carpeta.</string>
    <string name="removed">Eliminado</string>
    <!-- The toolbar entry that brings the format list back once the first file has been
         opened, because the first-run block never returns on its own. -->
    <string name="formats_menu">Formatos que abre</string>
    <string name="formats_title">Formatos que abre</string>
    <string name="formats_detail">Todo se dibuja en tu teléfono con las bibliotecas que vienen dentro de la app. Nunca se descarga nada ni se envía tu archivo a ningún servidor.</string>
    <string name="close">Cerrar</string>
    <!-- Las cuatro apariencias: el menu que las elige y sus nombres. -->
    <string name="apariencia_menu">Apariencia</string>
    <string name="apariencia_titulo">Apariencia</string>
    <string name="apariencia_rosa">Rosa</string>
    <string name="apariencia_grafito">Grafito (oscuro)</string>
    <string name="apariencia_azul">Azul</string>
    <string name="apariencia_gris">Gris</string>
    <!-- Releasing a folder grant is the one thing on this screen that cannot be undone:
         Android has no way to re-take a released permission, so the reader would have to
         walk the system picker again. Hence the only confirmation in the app. -->
    <string name="remove_folder_title">¿Quitar la carpeta?</string>
    <string name="remove_folder_message">Trini Office perderá acceso a %1$s. Para volver a concederlo tendrás que buscarla otra vez en el selector del sistema.</string>
    <!-- Also the TalkBack label for the long-press that removes a row -->
    <string name="remove">Quitar</string>
    <string name="search_in_document">Buscar en el documento</string>
    <string name="share_file">Compartir</string>
    <string name="show_in_file_manager">Mostrar en el administrador de archivos</string>
    <string name="no_file_manager">Ninguna app puede abrir esta carpeta</string>
    <string name="share_failed">Este archivo no se puede compartir</string>
    <string name="previous_match">Coincidencia anterior</string>
    <string name="next_match">Coincidencia siguiente</string>
    <string name="close_search">Cerrar la búsqueda</string>
    <string name="match_count">%1$d/%2$d</string>
    <!-- Spoken form: screen readers read "2/7" as "two sevenths" -->
    <string name="match_count_spoken">Coincidencia %1$d de %2$d</string>
    <string name="no_matches">Sin coincidencias</string>
    <string name="page_indicator">%1$d/%2$d</string>
    <!-- Spoken form, for the same reason match_count has one: a screen reader reads
         "12/357" as a fraction -->
    <string name="page_indicator_spoken">Página %1$d de %2$d</string>
    <string name="go_to_page">Ir a la página</string>
    <!-- Turns the page itself dark, which the phone's own dark mode deliberately does
         not: a document is paper and stays white at midnight. Named for what it is for
         rather than what it does, because "invert" describes the arithmetic and this is
         the only place in the app a reader meets it. -->
    <string name="night_mode">Modo nocturno</string>
    <string name="page_number">Número de página</string>
    <string name="page_range">1 a %1$d</string>
    <string name="page_out_of_range">Escribe una página entre 1 y %1$d</string>
    <string name="go">Ir</string>
    <!-- What the readout says while the thumb is dragged through anything that is not
         a PDF, where nothing else knows how far in you are -->
    <string name="scroll_position">%1$d%%</string>
    <string name="scroll_position_spoken">%1$d por ciento del documento</string>
    <string name="open_with_hint">Consejo: en tu administrador de archivos, toca cualquier archivo y elige Abrir con &gt; Trini Office.</string>
    <string name="back">Atrás</string>
    <string name="about_gander">Acerca de Trini Office</string>
    <!-- The two home menu items above About. Rate only appears where Google Play
         installed it. -->
    <string name="rate_app">Calificar</string>
    <string name="share_app">Compartir</string>
    <!-- What Share hands over. The link is the upstream project, which is where the
         source and the licence text live. -->
    <string name="share_app_text">Trini Office, un visor de archivos sin conexión para Android: %1$s</string>
    <string name="about_version">Versión %1$s</string>
    <string name="about_permissions_label">Permisos que solicita esta app</string>
    <string name="about_permissions_none">Ninguno</string>
    <!-- Sits under the permission line, which the app reads back from Android at
         runtime rather than asserting for itself -->
    <string name="about_permissions_detail">Se le preguntan a Android en este momento, no están escritos aquí de antemano. Trini Office tampoco tiene permiso de internet, así que no puede enviar tus archivos a ningún lado.</string>
    <string name="about_made_by">Autor original: Arjun Maniyani</string>
    <string name="about_made_by_url" translatable="false">arjun.maniyani.com</string>
    <string name="about_source">Código fuente</string>
    <string name="about_source_url" translatable="false">github.com/mokshablr/gander</string>
    <string name="about_licences">Licencias de código abierto</string>
    <string name="about_licences_detail">Texto completo de cada biblioteca incluida</string>
    <string name="about_copyright" translatable="false">MIT licence. Copyright © 2026 Arjun Maniyani.</string>
    <string name="about_close">Cerrar</string>
    <string name="no_browser">Ninguna app puede abrir enlaces</string>
    <!-- Becomes the viewer's title, so it reads as the document it is -->
    <string name="licences_file_name" translatable="false">Open source licences.md</string>
    <string name="licences_failed">No se puede abrir el archivo de licencias</string>
    <!-- Shown where the document was, after Android takes the renderer process
         away. Two titles because the two causes are not the same thing: the
         common one is the system reclaiming memory, which is nobody's fault and
         says nothing about the file, and the rare one is the renderer failing. -->
    <string name="render_gone_reclaimed">Android cerró este documento para liberar memoria</string>
    <string name="render_gone_crashed">El visor de documentos se detuvo de forma inesperada</string>
    <string name="render_gone_detail">El archivo está intacto. Volver a cargarlo suele funcionar.</string>
    <string name="render_gone_reload">Volver a cargar</string>
    <string name="save_copy">Guardar una copia</string>
    <string name="save_copy_done">Copia guardada</string>
    <string name="save_copy_failed">No se pudo guardar la copia</string>
    <string name="url_author" translatable="false">https://arjun.maniyani.com/</string>
    <string name="url_source" translatable="false">https://github.com/mokshablr/gander</string>
    <string name="url_site" translatable="false">https://arjun.maniyani.com/gander/</string>
    <!-- Only reached when the Play Store app will not open the listing itself -->
    <string name="url_play_listing" translatable="false">https://play.google.com/store/apps/details?id=%1$s</string>
</resources>
